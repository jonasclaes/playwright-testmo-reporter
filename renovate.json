{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": {
    "enabled": true,
    "title": "Renovate Dashboard"
  },
  "labels": ["renovate"],
  "configMigration": true,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "packageRules": [
    {
      "matchDatasources": ["npm"],
      "groupName": "npm dependencies"
    }
  ]
}
